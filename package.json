{
  "name": "super-trasen-team",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gungi/server & npm run dev -w @gungi/client & wait",
    "build": "npm run build --workspaces --if-present",
